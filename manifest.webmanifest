{
  "name": "Health Log",
  "short_name": "Health Log",
  "description": "Personal health log. Your data stays on this device.",
  "start_url": "./index.html#today",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#fbf6f0",
